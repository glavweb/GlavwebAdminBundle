{
    "name": "glavweb/admin-bundle",
    "type": "symfony-bundle",
    "description": "Sonata Admin extras for Glavweb projects",
    "license": "MIT",
    "authors": [
        {
            "name": "Andrey Nilov",
            "email": "nilov@glavweb.ru",
            "homepage": "https://glavweb.ru"
        },
        {
            "name": "Glavweb Community",
            "homepage": "https://github.com/glavweb/GlavwebAdminBundle/contributors"
        }
    ],
    "require": {
        "php": ">=8.4",
        "glavweb/extra-bundle": "^1.0",
        "glavweb/framework-bundle": "^1.0",
        "sonata-project/admin-bundle": "^4.6",
        "sonata-project/doctrine-orm-admin-bundle": "^4.0",
        "doctrine/orm": "^3.3",
        "symfony/form": "^8.0",
        "symfony/framework-bundle": "^8.0"
    },
    "suggest": {
        "glavweb/uploader-bundle": "Media list/show templates and make:admin uploadable fields",
        "phpoffice/phpspreadsheet": "Required for XlsxWriter",
        "symfony/maker-bundle": "Required for make:admin"
    },
    "autoload": {
        "psr-4": {
            "Glavweb\\AdminBundle\\": "src/"
        }
    }
}
