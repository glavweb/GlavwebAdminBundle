{% if admin.hasAccess('create') and admin.hasRoute('create') %}
    {% if admin.subClasses is empty %}
        {% set labelName = admin.labelTranslatorStrategy.getLabel(admin.classnameLabel ~ '_action_create', 'button', 'link') %}
        {% set labelNameTranslated = labelName|trans({}, admin.translationDomain) %}
        <li>
            <a class="sonata-action-element" href="{{ admin.generateUrl('create') }}">
                <i class="fa fa-plus" aria-hidden="true"></i>
                {% if labelName == labelNameTranslated %}
                    {{ 'link_action_create'|trans({}, 'SonataAdminBundle') }}
                {% else %}
                    {{ labelNameTranslated }}
                {% endif %}
            </a>
        </li>
    {% else %}
        {% for subclass in admin.subclasses|keys %}
            {% set labelName = admin.labelTranslatorStrategy.getLabel(admin.classnameLabel ~ '_' ~ subclass ~ '_action_create', 'button', 'link') %}
            {% set labelNameTranslated = labelName|trans({}, admin.translationDomain) %}
            <li>
                <a class="sonata-action-element" href="{{ admin.generateUrl('create', {'subclass': subclass}) }}">
                    <i class="fa fa-plus" aria-hidden="true"></i>
                    {% if labelName == labelNameTranslated %}
                        {{ 'link_action_create'|trans({}, 'SonataAdminBundle') }} {{ subclass|trans({}, admin.translationdomain) }}
                    {% else %}
                        {{ labelNameTranslated }}
                    {% endif %}
                </a>
            </li>
        {% endfor %}
    {% endif %}
{% endif %}
