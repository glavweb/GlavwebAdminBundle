{% if admin.hasAccess('show', object) and admin.hasRoute('show') %}
    {% set labelName = admin.labelTranslatorStrategy.getLabel(admin.classnameLabel ~ '_action_show', 'button', 'link') %}
    {% set labelNameTranslated = labelName|trans({}, admin.translationDomain) %}

    <li>
        <a class="sonata-action-element" href="{{ admin.generateObjectUrl('show', object) }}">
            <i class="fa fa-search" aria-hidden="true"></i>
            {% if labelName == labelNameTranslated %}
                {{ 'link_action_show'|trans({}, 'SonataAdminBundle') }}
            {% else %}
                {{ labelNameTranslated }}
            {% endif %}
        </a>
    </li>
{% endif %}
