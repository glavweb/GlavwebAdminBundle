<script type="text/javascript">
    jQuery('div#field_container_{{ id }} .sonata-ba-tbody').first().sortable({
        axis: 'y',
        opacity: 0.6,
        items: '> .sonata-collection-row',
        handle: '.sonata-ba-sortable-handler',
        stop: apply_position_value_{{ id }}
    });

    function apply_position_value_{{ id }}() {
        jQuery('div#field_container_{{ id }} .sonata-ba-tbody .sonata-ba-td-{{ id }}-{{ sonata_admin.field_description.option('sortable') }} input').each(function(index, value) {
            jQuery(value).val(index + 1);
        });
    }

    jQuery('#sonata-ba-field-container-{{ id }}').bind('sonata.add_element', function() {
        apply_position_value_{{ id }}();
        jQuery('div#field_container_{{ id }} .sonata-ba-tbody').sortable('refresh');
    });

    apply_position_value_{{ id }}();
</script>
