{#
  CRM inline 'table': real table, labels once in thead, delete icon instead of checkbox.
#}
{% set header_fields = form.children|first.children %}

<table class="table table-bordered sonata-ba-inline-table">
    <thead>
        <tr>
            {% for field_name, nested_field in header_fields %}
                {% if field_name != '_delete' %}
                    <th
                        class="{% if nested_field.vars['required']|default(false) %}required{% endif %}"
                        {% if nested_field.vars['attr']['hidden']|default(false) %}
                            style="display:none;"
                        {% endif %}
                    >
                        {% if nested_field.vars.translation_domain is same as(false) %}
                            {{ nested_field.vars.label }}
                        {% else %}
                            {% set translationDomain = nested_field.vars.translation_domain|default(nested_field.vars['sonata_admin'].admin.translationDomain|default(null)) %}
                            {{ nested_field.vars.label|trans({}, translationDomain) }}
                        {% endif %}
                    </th>
                {% endif %}
            {% endfor %}
            {% if header_fields['_delete'] is defined %}
                <th class="sonata-ba-inline-table__actions"></th>
            {% endif %}
        </tr>
    </thead>
    <tbody class="sonata-ba-tbody">
        {% for nested_group_field_name, nested_group_field in form.children %}
            {% set collection_item = nested_group_field.vars.data ?? null %}
            {% set collection_persisted = collection_item is not null and collection_item.id %}
            {% set collection_deleted = nested_group_field['_delete'] is defined and nested_group_field['_delete'].vars.checked %}
            <tr class="{% if collection_deleted %}sonata-collection-item--pending-delete{% endif %}" data-sonata-collection-item data-sonata-collection-persisted="{{ collection_persisted ? '1' : '0' }}">
                <td class="sonata-collection-item__pending" colspan="{{ header_fields|length }}">
                    {% include '@SonataAdmin/CRUD/Association/_inline_collection_pending_delete.html.twig' %}
                </td>
                {% for field_name, nested_field in nested_group_field.children %}
                    {% if field_name != '_delete' %}
                        <td class="
                            sonata-ba-td-{{ id }}-{{ field_name }}
                            form-group
                            control-group
                            {% if nested_field.vars.errors|default(false) %} error has-error sonata-ba-field-error{% endif %}
                            "
                            {% if nested_field.vars['attr']['hidden']|default(false) %}
                                style="display:none;"
                            {% endif %}
                        >
                            {% if sonata_admin.field_description.associationadmin.formfielddescriptions[field_name] is defined %}
                                {{ form_widget(nested_field) }}
                                {{ form_help(nested_field) }}
                                {% set dummy = nested_group_field.setrendered %}
                            {% else %}
                                {{ form_widget(nested_field) }}
                                {{ form_help(nested_field) }}
                            {% endif %}
                            {% if nested_field.vars.errors|default(false) %}
                                <div class="help-block help-inline sonata-ba-field-error-messages">
                                    {{ form_errors(nested_field) }}
                                </div>
                            {% endif %}
                        </td>
                    {% endif %}
                {% endfor %}
                {% if nested_group_field['_delete'] is defined %}
                    <td class="sonata-ba-inline-table__actions">
                        {% include '@SonataAdmin/CRUD/Association/_inline_collection_delete.html.twig' %}
                    </td>
                {% endif %}
            </tr>
        {% endfor %}
    </tbody>
</table>
