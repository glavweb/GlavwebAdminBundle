{% if admin.hasAccess('edit', object) and admin.hasRoute('edit') %}
    <a href="{{ admin.generateUrl('create', {'clone': 'true', 'sourceId': object.id}) }}" class="btn btn-icon btn-ghost" title="{{ 'link_action_clone'|trans({}, 'SonataAdminBundle') }}">
        <i class="fa fa-clone" aria-hidden="true"></i>
    </a>
{% endif %}
