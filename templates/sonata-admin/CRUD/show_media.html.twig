{% extends '@SonataAdmin/CRUD/base_show_field.html.twig' %}

{% block field_value %}
    {%- include '@GlavwebAdmin/sonata-admin/CRUD/display_media.html.twig' with {
        value: value,
        provider_options: field_description.option('provider_options',{
            'image_attributes': {'style': 'max-height: 300px;max-width:500px;'},
            'link_attributes': {'target': '_blank'}}),
        class: field_description.option('class', null),
        style: field_description.option('style', null)
    } only -%}
{% endblock %}
