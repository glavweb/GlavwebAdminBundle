{% extends get_global_template('layout') %}

{% block sonata_nav %}
{% endblock sonata_nav %}

{% block logo %}
{% endblock logo %}

{% block sonata_left_side %}
{% endblock sonata_left_side %}

{% block body_attributes %}class="sonata-bc login-page"{% endblock %}

{% block sonata_wrapper %}
    <div class="login-box">
        <div class="login-logo">
            <a href="{{ path('sonata_admin_dashboard') }}">
                <span>{% block login_title %}{{ sonata_config.title|default(app_name|default('Admin')) }}{% endblock %}</span>
            </a>
        </div>
        <div class="login-box-body">
            {% block sonata_user_login_form %}
                {% block sonata_user_login_error %}
                    {% if error %}
                        <div class="alert alert-danger">
                            {% if error.messageKey is defined %}
                                {{ error.messageKey|trans(error.messageData|default({}), 'security') }}
                            {% else %}
                                {{ error|trans({}, 'messages') }}
                            {% endif %}
                        </div>
                    {% endif %}
                {% endblock %}

                {% for label, flashes in app.session.flashbag.all %}
                    {% for flash in flashes %}
                        <div class="alert alert-{{ label }}">
                            {{ flash }}
                        </div>
                    {% endfor %}
                {% endfor %}

                <p class="login-box-msg">{% block login_box_msg %}{{ 'login.box_msg'|trans({}, 'GlavwebAdminBundle') }}{% endblock %}</p>

                <form action="{% block login_check_path %}{{ path('app_admin_login') }}{% endblock %}" method="post" role="form">
                    <div class="form-group has-feedback">
                        <input type="text" class="form-control" id="username" name="_username" value="{{ last_username }}" autocomplete="username" autofocus required="required" placeholder="{{ 'login.username'|trans({}, 'GlavwebAdminBundle') }}"/>
                        <span class="glyphicon glyphicon-user form-control-feedback"></span>
                    </div>

                    <div class="form-group has-feedback">
                        <input type="password" class="form-control" id="password" name="_password" autocomplete="current-password" required="required" placeholder="{{ 'login.password'|trans({}, 'GlavwebAdminBundle') }}"/>
                        <span class="glyphicon glyphicon-lock form-control-feedback"></span>
                    </div>

                    {% block login_csrf %}
                        <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">
                    {% endblock %}

                    <div class="row d-flex align-items-center">
                        <div class="col-xs-8">
                            {% block login_remember_me %}
                                <div class="checkbox icheck">
                                    <label>
                                        <input type="checkbox" id="remember_me" name="_remember_me" value="on"/>
                                        {{ 'login.remember_me'|trans({}, 'GlavwebAdminBundle') }}
                                    </label>
                                </div>
                            {% endblock %}
                        </div>
                        <div class="col-xs-4">
                            <button type="submit" class="btn btn-primary btn-block btn-flat">{{ 'login.submit'|trans({}, 'GlavwebAdminBundle') }}</button>
                        </div>
                    </div>
                </form>
            {% endblock %}
        </div>
    </div>
{% endblock sonata_wrapper %}
