{% extends '@SonataAdmin/CRUD/list_string.html.twig' %}

{% block field %}
    {% set current_position = currentObjectPosition(object) %}
    {% set last_position    = lastPosition(object) %}
    {% set enable_top_bottom_buttons = field_description.options.enable_top_bottom_buttons ?? true %}

    <span class="btn btn-sm btn-default js-sortable-move"
          data-current-position="{{ current_position }}"
          data-url="{{ admin.generateObjectUrl('move', object, {'position': 'NEW_POSITION'}) }}"
          title="{{ 'move_drag'|trans({}, 'admin') }}">
        <i class="fa fa-arrows"></i>
    </span>

    {% if enable_top_bottom_buttons and current_position < last_position %}
        <a class="btn btn-sm btn-default" href="{{ admin.generateObjectUrl('move', object, {'position': 'bottom'}|merge({filter: admin.filterParameters})) }}" title="{{ 'move_to_bottom'|trans({}, 'admin') }}">
            <i class="fa fa-angle-double-down"></i>
        </a>
    {% endif %}

    {% if enable_top_bottom_buttons and current_position > 0 %}
        <a class="btn btn-sm btn-default" href="{{ admin.generateObjectUrl('move', object, {'position': 'top'}|merge({filter: admin.filterParameters})) }}" title="{{ 'move_to_top'|trans({}, 'admin') }}">
            <i class="fa fa-angle-double-up"></i>
        </a>
    {% endif %}
{% endblock %}
